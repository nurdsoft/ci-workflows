#!/bin/bash

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Allow merge commits
if echo "$commit_msg" | grep -qE "^Merge "; then
  exit 0
fi

# Pattern: <type>[(<scope>)][!]: <description>
if ! echo "$commit_msg" | grep -qE "^(feat|fix|chore|docs|ci|refactor|test|perf)(\([a-z0-9/-]+\))?(!)?: .+$"; then
  echo ""
  echo "❌ BLOCKED: Commit message does not follow convention."
  echo ""
  echo "✅ Format:  <type>[(<scope>)]: <description>"
  echo ""
  echo "📌 Types:   feat | fix | chore | docs | ci | refactor | test | perf"
  echo ""
  echo "📌 Examples:"
  echo "   feat(deploy): add Cloud Run job support"
  echo "   fix(build): resolve duplicate step names"
  echo "   chore: update action pin hashes"
  echo "   docs: update README with new inputs"
  echo ""
  exit 1
fi
